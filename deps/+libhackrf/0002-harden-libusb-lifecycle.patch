@@ -428,6 +463,10 @@ static int prepare_transfers(
 	if (error == 0) {
 		return HACKRF_SUCCESS;
 	} else {
+		int submit_error = error;
+		if (device->transfers_setup)
+			(void) cancel_transfers(device);
+		last_libusb_error = submit_error;
 		return HACKRF_ERROR_LIBUSB;
 	}
 }
@@ -507,13 +546,23 @@ int ADDCALL hackrf_init(void)
 	}
 
 #if defined(DISABLE_USB_DEVICE_DISCOVERY) || defined(__ANDROID__)
-	/* An unprivileged Android app cannot walk the USB bus, so libusb must
-	 * not try; the caller hands us an already-open fd instead, via
