  * pending transfers.
  *
  * Returns HACKRF_SUCCESS if OK, HACKRF_ERROR_OTHER if the
- * transfers aren't currently setup.
+ * transfers aren't currently setup or could not be reaped.
  */
 static int cancel_transfers(hackrf_device* device)
 {
 	uint32_t transfer_index;
+	int drain_slice;
+	int active_transfers;
+	int result;
+	struct timeval timeout = {0, 10000};
 
 	// If we're cancelling transfers for any reason, we're shutting down.
 	device->streaming = false;
 
-	if (transfers_check_setup(device) == true) {
-		// Take lock while cancelling transfers. This blocks the
-		// transfer completion callback from restarting a transfer
-		// while we're in the middle of trying to cancel them all.
-		pthread_mutex_lock(&device->transfer_lock);
+	// Take lock while cancelling transfers. This blocks the transfer
+	// completion callback from restarting a transfer while we're in the
+	// middle of trying to cancel them all.
+	pthread_mutex_lock(&device->transfer_lock);
+	if (device->transfers_stuck) {
+		pthread_mutex_unlock(&device->transfer_lock);
+		return HACKRF_ERROR_OTHER;
+	}
+	if (transfers_check_setup(device) == false && device->active_transfers <= 0) {
+		pthread_mutex_unlock(&device->transfer_lock);
+		return HACKRF_ERROR_OTHER;
+	}
 
-		for (transfer_index = 0; transfer_index < TRANSFER_COUNT;
-		     transfer_index++) {
-			if (device->transfers[transfer_index] != NULL) {
-				libusb_cancel_transfer(device->transfers[transfer_index]);
-			}
+	for (transfer_index = 0; transfer_index < TRANSFER_COUNT; transfer_index++) {
+		if (device->transfers[transfer_index] != NULL) {
+			libusb_cancel_transfer(device->transfers[transfer_index]);
 		}
+	}
 
-		if (device->flush_transfer != NULL)
-			libusb_cancel_transfer(device->flush_transfer);
+	if (device->flush_transfer != NULL)
+		libusb_cancel_transfer(device->flush_transfer);
 
-		device->transfers_setup = false;
-		device->flush = false;
+	device->transfers_setup = false;
+	device->flush = false;
+	pthread_mutex_unlock(&device->transfer_lock);
 
-		// Now wait for the transfer thread to signal that all transfers
-		// have finished, either by completing or being fully cancelled.
-		while (device->active_transfers > 0) {
-			pthread_cond_wait(
-				&device->all_finished_cv,
-				&device->transfer_lock);
-		}
+	/* Drain with a bounded deadline. If the wrapped fd was closed under
+	 * libusb, cancellation can fail with EBADF and no callbacks will arrive. */
+	for (drain_slice = 0; drain_slice < 50; drain_slice++) {
+		pthread_mutex_lock(&device->transfer_lock);
+		active_transfers = device->active_transfers;
 		pthread_mutex_unlock(&device->transfer_lock);
+		if (active_transfers <= 0)
+			break;
 
-		return HACKRF_SUCCESS;
-	} else {
-		return HACKRF_ERROR_OTHER;
+		result = libusb_handle_events_timeout_completed(
+			g_libusb_context,
+			&timeout,
+			NULL);
+		if (result < 0 && result != LIBUSB_ERROR_INTERRUPTED) {
+			break;
+		}
 	}
+
+	pthread_mutex_lock(&device->transfer_lock);
+	device->transfers_stuck = (device->active_transfers > 0);
+	active_transfers = device->active_transfers;
+	pthread_mutex_unlock(&device->transfer_lock);
+
+	return active_transfers > 0 ? HACKRF_ERROR_OTHER : HACKRF_SUCCESS;
 }
 
 static int free_transfers(hackrf_device* device)
 {
 	uint32_t transfer_index;
 
+	if (device->transfers_stuck)
+		return HACKRF_ERROR_OTHER;
+
 	if (device->transfers != NULL) {
 		// libusb_close() should free all transfers referenced from this array.
 		for (transfer_index = 0; transfer_index < TRANSFER_COUNT;
@@ -335,7 +362,7 @@ static int prepare_transfers(
 	const uint_fast8_t endpoint_address,
 	libusb_transfer_cb_fn callback)
 {
-	int error;
+	int error = LIBUSB_SUCCESS;
 	uint32_t transfer_index;
 	uint32_t ready_transfers = 0;
 
@@ -343,6 +370,9 @@ static int prepare_transfers(
 		// This shouldn't happen.
 		return HACKRF_ERROR_OTHER;
 	}
+	if (device->transfers_stuck) {
+		return HACKRF_ERROR_OTHER;
+	}
 
