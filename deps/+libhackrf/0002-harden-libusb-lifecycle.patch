 {
 	int i;
+	int result;
 	libusb_device_handle* usb_device = NULL;
 	uint8_t serial_descriptor_index;
-	char serial_number[64];
-	uint8_t idx, serial_number_length;
+	char serial_number[64] = {0};
+	int idx, serial_number_length;
+	ssize_t usb_devicecount;
 
