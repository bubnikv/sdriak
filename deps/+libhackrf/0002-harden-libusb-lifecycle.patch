-	libusb_set_option(NULL, LIBUSB_OPTION_NO_DEVICE_DISCOVERY, NULL);
+	/* An unprivileged Android app cannot walk the USB bus; it hands us an
+	 * already-open fd instead. Apply the option atomically when supported. */
+#if defined(LIBUSB_API_VERSION) && (LIBUSB_API_VERSION >= 0x0100010A)
