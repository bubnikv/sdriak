+		{.option = LIBUSB_OPTION_NO_DEVICE_DISCOVERY},
+	};
+	libusb_error = libusb_init_context(&g_libusb_context, options, 1);
+#else
+	libusb_error =
+		libusb_set_option(NULL, LIBUSB_OPTION_NO_DEVICE_DISCOVERY, NULL);
+	if (libusb_error == LIBUSB_SUCCESS)
+		libusb_error = libusb_init(&g_libusb_context);
 #endif
-
+#else
 	libusb_error = libusb_init(&g_libusb_context);
+#endif
+
 	if (libusb_error != 0) {
 		last_libusb_error = libusb_error;
 		return HACKRF_ERROR_LIBUSB;
@@ -555,18 +604,30 @@ const char* ADDCALL hackrf_library_release()
