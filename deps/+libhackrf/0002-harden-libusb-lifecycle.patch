 	// transfer buffer.
@@ -420,6 +450,11 @@ static int prepare_transfers(
 				last_libusb_error = error;
 			}
 		}
+	} else {
+		/* A later submission can fail after earlier transfers were accepted.
+		 * Mark that partial set as owned by libusb so it is cancelled below. */
+		device->streaming = false;
+		device->transfers_setup = (device->active_transfers > 0);
 	}
 
