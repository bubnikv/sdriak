From be55c49d86841d4115d4735f194c49c48b82bc98 Mon Sep 17 00:00:00 2001
From: Marcelo Gadotti <eng.marcelogadotti@gmail.com>
Date: Wed, 9 Sep 2026 14:24:57 -0300
Subject: [PATCH 1/2] Add Android open-by-fd support (ported from
 AlexandreRouma/rtl-sdr@40a1598)

Ports the small Android-specific patch (rtlsdr_create_device /
rtlsdr_init_device / rtlsdr_free_device split, rtlsdr_open_sys_dev,
libusb NO_DEVICE_DISCOVERY under __ANDROID__) onto current osmocom
master (v2.0.3), which already carries RTL-SDR Blog V4 and V4L
tuner-detection support that AlexandreRouma/rtl-sdr (stalled since
Jan 2024) lacks. Also ports the BUILD_UTILITIES CMake option used by
android-sdr-kit's build.sh to skip building rtl_test/rtl_fm/etc for
Android.
---
 include/rtl-sdr.h  |  12 ++++
 src/CMakeLists.txt |   6 ++
 src/librtlsdr.c    | 161 ++++++++++++++++++++++++++++++---------------
 3 files changed, 127 insertions(+), 52 deletions(-)

diff --git a/include/rtl-sdr.h b/include/rtl-sdr.h
index d64701e..fca23af 100644
--- a/include/rtl-sdr.h
+++ b/include/rtl-sdr.h
@@ -62,6 +62,18 @@ RTLSDR_API int rtlsdr_get_index_by_serial(const char *serial);
 
 RTLSDR_API int rtlsdr_open(rtlsdr_dev_t **dev, uint32_t index);
 
+/*!
+ * Open a device from an already-opened OS-level USB file descriptor
+ * (e.g. one handed out by Android's UsbManager), bypassing libusb's
+ * own device discovery. Ported from AlexandreRouma/rtl-sdr@40a1598,
+ * needed by SDR++'s Android build (source_modules/rtl_sdr_source).
+ *
+ * \param out_dev the device handle, set on success
+ * \param sys_dev an OS-level file descriptor for the USB device
+ * \return 0 on success, negative on error, -1 on unsupported platform
+ */
+RTLSDR_API int rtlsdr_open_sys_dev(rtlsdr_dev_t **out_dev, intptr_t sys_dev);
+
 RTLSDR_API int rtlsdr_close(rtlsdr_dev_t *dev);
 
 /* configuration functions */
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 408a270..d74b97f 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -86,6 +86,9 @@ endif()
 ########################################################################
 # Build utility
 ########################################################################
+option(BUILD_UTILITIES "Build utilities for the RTL-SDR such as rtl_tcp, rtl_test, rtl_fm, etc..." ON)
+
+if (BUILD_UTILITIES)
 add_executable(rtl_sdr rtl_sdr.c)
 add_executable(rtl_tcp rtl_tcp.c)
 add_executable(rtl_test rtl_test.c)
@@ -157,6 +160,7 @@ set_property(TARGET rtl_adsb APPEND PROPERTY COMPILE_DEFINITIONS "rtlsdr_STATIC"
 set_property(TARGET rtl_power APPEND PROPERTY COMPILE_DEFINITIONS "rtlsdr_STATIC" )
 set_property(TARGET rtl_biast APPEND PROPERTY COMPILE_DEFINITIONS "rtlsdr_STATIC" )
 endif()
+endif()
 ########################################################################
 # Install built library files & utilities
 ########################################################################
@@ -166,6 +170,8 @@ install(TARGETS rtlsdr EXPORT RTLSDR-export
 install(TARGETS rtlsdr_static EXPORT RTLSDR-export
   ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} # .so/.dylib file
   )
+if (BUILD_UTILITIES)
 install(TARGETS rtl_sdr rtl_tcp rtl_test rtl_fm rtl_eeprom rtl_adsb rtl_power rtl_biast
   DESTINATION ${CMAKE_INSTALL_BINDIR}
   )
+endif()
