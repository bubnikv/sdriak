index 55d2ef1..44069b8 100644
--- a/src/librtlsdr.c
+++ b/src/librtlsdr.c
@@ -1442,66 +1442,52 @@ int rtlsdr_check_dongle_model(void *dev, char *manufact_check, char *product_che
 }
 
 
