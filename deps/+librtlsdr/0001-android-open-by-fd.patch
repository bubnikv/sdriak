-
-		libusb_get_device_descriptor(list[i], &dd);
-
-		if (find_known_device(dd.idVendor, dd.idProduct)) {
-			device_count++;
-		}
-
-		if (index == device_count - 1)
-			break;
+	return 0;
+}
 
-		device = NULL;
-	}
+void rtlsdr_free_device(rtlsdr_dev_t *dev)
+{
+	if (dev) {
+		if (dev->devh)
+			libusb_close(dev->devh);
 
-	if (!device) {
-		r = -1;
-		goto err;
-	}
+		if (dev->ctx)
+			libusb_exit(dev->ctx);
 
-	r = libusb_open(device, &dev->devh);
