+// The slow-clock witness: a clock learned too slow (a noise-polluted
+// bootstrap) is self-consistent — true dits fall under the Dit window's
+// 0.6-dit floor, the lattice glues them with their gaps, and the re-lock ring
+// only ever sees the glued marks. The trigger on the raw envelope still sees
+// the true marks. On a strong channel (v2 view, peak 8× the floor, where noise
+// runs cannot pass for marks), when the shortest tight class of its last
+// marks (at least 3 within 1.5×) sits under 0.6 dit, the clock jumps to it.
+void CwState::witness_step(float env) {
+    if (weak_view() || m_clock.dit() <= 0 || !m_lattice.active()) {
+        m_wit_n = 0;
+        m_witness.idle();
+        return;
+    }
+    CwSchmitt::Run run;
+    if (!m_witness.step(env, m_levels.env_lo(), m_levels.env_hi(), run))
+        return;
+    m_witness.settle();
+    if (!run.key || run.len < CwSchmitt::kGlitch)
+        return;
+    m_wit[m_wit_head++ % kWitnessMarks] = static_cast<float>(run.len);
+    if (m_wit_n < kWitnessMarks) { m_wit_n++; }
+    if (m_wit_n < 6 || m_levels.env_hi() < 8.0 * m_levels.env_lo())
+        return;
+    float s[kWitnessMarks];
+    std::copy_n(m_wit, m_wit_n, s);
+    std::sort(s, s + m_wit_n);
+    for (unsigned i = 0; i + 2 < m_wit_n; i++) {
+        if (s[i + 2] <= 1.5f * s[i]) {
+            double sum = 0.0;
+            unsigned cnt = 0;
+            for (unsigned j = i; j < m_wit_n && s[j] <= 1.5f * s[i]; j++) {
+                sum += s[j];
+                cnt++;
+            }
+            const double est = sum / cnt;
+            if (est < 0.6 * m_clock.dit()) {
+                CW_DBG(m_trace, "[witness: clock %.1f too slow, marks at %.1f; jump]\n",
+                       m_clock.dit(), est);
+                m_clock.set_dit(std::clamp(est, m_rate * 0.022, m_rate * 0.30));
+                m_clock.clear_rings();
+                m_wit_n = 0;
+            }
+            return;
+        }
+    }
+}
