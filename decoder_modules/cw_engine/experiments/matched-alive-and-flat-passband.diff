@@ -23,6 +23,17 @@
 // destructor, the rest the methods of the same names).
 class SkimChannelizer {
 public:
+    // The CW bank with a flat passband: create_ex(in_rate, 125,
+    // kCwFlatPassbandHz, kCwFlatTaps). The default prototype (±62.5 Hz,
+    // 8 taps a branch) is flat only to ±30 Hz and −6 dB at the channel edge,
+    // so a tone midway between two channels costs v3 3.3 dB in both. This
+    // one is −0.2 dB at ±62.5 Hz and still over 100 dB down at the output
+    // Nyquist (125 Hz), for 0.3 dB at the centre and 1.5× the polyphase
+    // work (ALGORITHM.md §5.3.6). v2's squelch reads the raw channel and
+    // loses 1.8 dB to the wider noise bandwidth; it is meant for v3.
+    static constexpr double   kCwFlatPassbandHz = 85.0;
+    static constexpr unsigned kCwFlatTaps = 12;
+
     // Create a channelizer for input at in_rate Hz with chan_bw_hz channel
     // spacing. in_rate/chan_bw_hz must be an even integer (the hop is M/2).
     // Empty on invalid geometry.
